# Скопируйте в .env и заполните. Файл читается из корня проекта.

# true — только для локальной разработки: фото отдаёт само приложение, cookie без Secure,
# работает /ui-kit, разрешён SECRET_KEY-заглушка. На сервере — false.
DEBUG=false

# Адрес сайта в браузере, БЕЗ слеша в конце. С ним сверяется Origin у POST-запросов (защита от CSRF):
# при неверном значении все формы отвечают 403. На сервере: https://english-st.ru
BASE_URL=http://127.0.0.1:8002

# Длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(48))"
# При DEBUG=false значение «change-me» не даёт приложению стартовать.
SECRET_KEY=change-me

# Необязательно. По умолчанию — data/site.db и media/ рядом с кодом (/srv/englishst/data, /srv/englishst/media).
# Если меняете, поправьте ReadWritePaths в englishst.service, alias в nginx.conf и пути в backup.sh.
# DATABASE_URL=sqlite:///data/site.db
# MEDIA_DIR=media
